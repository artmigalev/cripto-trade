{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"],
    "cache": {
      "enabled": true
    },
    "analytics": false
  },

  "newProjectRoot": "projects",
  "projects": {
    "crypto-trade": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "path": "src/app/components",
          "standalone": true,
          "displayBlock": true,
          "changeDetection": "OnPush",
          "skipTests": false,
          "inlineTemplate": false,
          "inlineStyle": false,
          "style": "scss",
          "prefix": "app",
          "addTypeToClassName": true,
          "type": "component"
        },
        "@schematics/angular:guard": {
          "path": "src/app/shared/guards"
        },
        "@schematics/angular:service": {
          "path": "src/app/core/services",
          "type": "service",
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "path": "src/app/shared/pipes",
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:interface": {
          "path": "src/app/interfaces",
          "type": "interface"
        },
        "@schematics/angular:enum": {
          "path": "src/enums",
          "type": "enum"
        },
        "@schematics/angular:directive": {
          "path": "src/app/shared/directives",
          "type": "directive",
          "skipTests": true,
          "standalone": true
        },
        "@schematics/angular:interceptor": {
          "path": "src/app/shared/interceptors",
          "functional": true,
          "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
          "path": "src/app/core/resolvers",
          "typeSeparator": "."
        }
      },

      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "loader": {
              ".svg": "text"
            },
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/material-theme.scss",
              "src/styles.css",
              "src/app/app.scss",
              "src/styles/_scss-material-variables.scss",
              "src/styles/variables.scss"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.config.json",
            "hmr": true,
            "liveReload": true,
            "poll": 2000
          },
          "configurations": {
            "production": {
              "buildTarget": "crypto-trade:build:production"
            },
            "development": {
              "buildTarget": "crypto-trade:build:development",
              "hmr": true,
              "liveReload": true,
              "poll": 2000
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": [
              "./test-setup.ts",
              "./node_modules/vitest-localstorage-mock"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
