{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },

  "newProjectRoot": "projects",
  "projects": {
    "crypto-trade": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "path": "src/app/components",
          "standalone": true,
          "displayBlock": true,
          "changeDetection": "OnPush",
          "skipTests": true,
          "inlineTemplate": false,
          "inlineStyle": false,
          "style": "scss",
          "prefix": "app",
          "addTypeToClassName": true,
          "type": "component"
        },
        "@schematics/angular:guard": {
          "path": "src/app/shared/guards"
        },
        "@schematics/angular:service": {
          "path": "src/app/core/services",
          "type": "service",
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "path": "src/app/shared/pipes",
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:interface": {
          "path": "src/app/interfaces",
          "type": "interface"
        },
        "@schematics/angular:enum": {
          "path": "src/enums",
          "type": "enum"
        },
        "@schematics/angular:directive": {
          "path": "src/app/shared/directives",
          "type": "directive",
          "skipTests": true,
          "standalone": true
        },
        "@schematics/angular:interceptor": {
          "path": "src/app/shared/interceptors",
          "functional": true
        }
      },

      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@ngx-env/builder:application",
          "options": {
            "outputPath": {
              "base": "dist/crypto-trade"
            },
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/material-theme.scss", "src/styles.css", "src/app/app.scss"],
            "security": {}
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@ngx-env/builder:dev-server",
          "options": {
            "proxyConfig": "proxy.config.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "crypto-trade:build:production"
            },
            "development": {
              "buildTarget": "crypto-trade:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
